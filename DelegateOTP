@Bean
@Order(1)
public SecurityFilterChain authorizationServerSecurityFilterChain(HttpSecurity http)
        throws Exception {

    OAuth2AuthorizationServerConfigurer authorizationServer =
            OAuth2AuthorizationServerConfigurer.authorizationServer();

    http
        .securityMatcher(authorizationServer.getEndpointsMatcher())
        .with(authorizationServer, server -> server
            .oidc(Customizer.withDefaults())
        )
        .exceptionHandling(exceptions -> exceptions
            .defaultAuthenticationEntryPointFor(
                new LoginUrlAuthenticationEntryPoint("/login"),
                new MediaTypeRequestMatcher(MediaType.TEXT_HTML)
            )
            .defaultAccessDeniedHandlerFor(
                missingMfaAuthoritiesHandler(),
                new MediaTypeRequestMatcher(MediaType.TEXT_HTML)
            )
        )
        .oauth2ResourceServer(rs -> rs.jwt(Customizer.withDefaults()));

    return http.build();
}

@Bean
public DelegatingMissingAuthorityAccessDeniedHandler missingMfaAuthoritiesHandler() {
    return DelegatingMissingAuthorityAccessDeniedHandler.builder()
            .addEntryPointFor(
                    new LoginUrlAuthenticationEntryPoint("/otp"),
                    FactorGrantedAuthority.OTT_AUTHORITY
            )
            .addEntryPointFor(
                    new LoginUrlAuthenticationEntryPoint("/login"),
                    FactorGrantedAuthority.PASSWORD_AUTHORITY
            )
            .build();
}
